# Determine the counts and percentages
covid_test_summary <- filtered_data %>%
group_by(FUSNCONSENT_numeric, covid_test) %>%
summarise(count = n()) %>%
mutate(total = sum(count),
percentage = (count / total) * 100) %>%
ungroup()
print(covid_test_summary)
